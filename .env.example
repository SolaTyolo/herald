# Herald 环境变量
# 复制后修改：cp .env.example .env
#
# 启动前加载（可选）：
#   set -a && source .env && set +a

# --- 核心 ---

# 本地开发
DEV_MODE=true

# REST 鉴权密钥（必填；Authorization: Bearer <API_KEY>）
API_KEY=herald-dev-key

# API 监听地址（仅 API 进程）
HTTP_ADDR=:8080

# Traefik 风格 providers.yaml（API 与 Asynq Worker 必须都能访问；支持热加载）
PROVIDERS_CONFIG=./config/providers.yaml

# local：单进程执行任务，不使用 Redis（投递结果默认 sync）
# asynq：Redis 任务队列；需另起 cmd/worker。REDIS_ADDR 仅此时需要
QUEUE_MODE=asynq

# remote 投递结果：async=Redis 结果队列（仅 asynq）；sync=等 HTTP 响应体
DELIVERY_RESULT_MODE=async

# 仅 QUEUE_MODE=asynq：Asynq、限流、投递结果队列、Worker↔API 事件桥
REDIS_ADDR=localhost:6379
# 可选；有 requirepass / ACL 密码时填写（与 go-redis / asynq Password 一致）
# REDIS_PASSWORD=
# 可选；Redis 逻辑库（默认 0）
# REDIS_DB=0

# Topic 触发时单次最大订阅者数
MAX_RECIPIENTS=100

# --- 内置 SMTP（smtp_email；发邮件时 API 与 Worker 都需要）---
# make docker-app 会通过 --env-file .env 注入到容器

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587   # 587=STARTTLS；465=SMTPS 隐式 TLS
# SMTP_FROM=noreply@example.com
# SMTP_USERNAME=   # 认证账号（多为完整邮箱，不是显示名）
# SMTP_PASSWORD=

# --- 存储 ---

# file = STORE_FILE_PATH 下 JSON 文件（无需数据库）
# db   = GORM + DB_DRIVER
STORE_TYPE=db

# postgres | mysql | sqlite（STORE_TYPE=db 时有效）
DB_DRIVER=postgres

# STORE_TYPE=db 时的 DSN（默认与 deploy/docker-compose.yml 中 Postgres 一致）
DATABASE_URL=postgres://herald:herald@localhost:5432/herald?sslmode=disable

# STORE_TYPE=file 时的数据目录（subscribers/ workflows/ 等 JSON 集合）
STORE_FILE_PATH=./data

# --- 日志 ---

# debug | info | warn | error
LOG_LEVEL=info

# text | json
LOG_FORMAT=text

# --- OpenTelemetry（可选）---

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# 运行时由 bootstrap 覆盖为 herald-api / herald-worker
OTEL_SERVICE_NAME=herald
OTEL_TRACES_ENABLED=true
OTEL_METRICS_ENABLED=true

# --- 快捷配置（取消注释其一）---

# 纯文件模式，无需 Postgres：
# STORE_TYPE=file
# STORE_FILE_PATH=./data

# MySQL：
# STORE_TYPE=db
# DB_DRIVER=mysql
# DATABASE_URL=herald:herald@tcp(localhost:3306)/herald?charset=utf8mb4&parseTime=True&Loc=Local

# GORM + SQLite 文件：
# STORE_TYPE=db
# DB_DRIVER=sqlite
# DATABASE_URL=./data/herald.db
